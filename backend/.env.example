# Server
PORT=3000
NODE_ENV=development
# Only needed if the frontend is hosted on a different domain (comma separated)
CLIENT_URL=http://localhost:5173

# Database / auth
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/auratune
JWT_SECRET=change-me-to-a-long-random-string

# ImageKit (song + poster storage)
IMAGEKIT_PRIVATE_KEY=private_xxx

# Redis (optional, token blacklist falls back to memory if omitted)
# REDIS_URL=redis://default:<password>@host:6379
# REDIS_HOST=
# REDIS_PORT=
# REDIS_PASSWORD=
